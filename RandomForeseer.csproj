<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project=".\local.props" Condition="Exists('.\local.props')" />

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>RandomForeseer</RootNamespace>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>

        <GodotExportPreset>Windows Desktop</GodotExportPreset>
        <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
        <PublishDir Condition="'$(PublishDir)' == ''">$(Sts2Dir)\mods\$(MSBuildProjectName)\</PublishDir>
        <SyncManifestDependenciesOnBuild Condition="'$(SyncManifestDependenciesOnBuild)' == ''">false</SyncManifestDependenciesOnBuild>
    </PropertyGroup>

    <PropertyGroup>
        <RandomForeseerManifestPath>$(MSBuildProjectDirectory)\RandomForeseer.json</RandomForeseerManifestPath>
        <_RandomForeseerManifestJson>$([System.IO.File]::ReadAllText('$(RandomForeseerManifestPath)'))</_RandomForeseerManifestJson>
        <_RandomForeseerVersionSearchPattern>"version"\s*:\s*"([^"]+)"</_RandomForeseerVersionSearchPattern>
        <_RandomForeseerVersionExtractPattern>(?s).*?"version"\s*:\s*"([^"]+)".*</_RandomForeseerVersionExtractPattern>
        <_HasRandomForeseerModVersion>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_RandomForeseerManifestJson)', '$(_RandomForeseerVersionSearchPattern)'))</_HasRandomForeseerModVersion>
        <RandomForeseerModVersion Condition="'$(_HasRandomForeseerModVersion)' == 'True'">$([System.Text.RegularExpressions.Regex]::Replace('$(_RandomForeseerManifestJson)', '$(_RandomForeseerVersionExtractPattern)', '$1'))</RandomForeseerModVersion>
    </PropertyGroup>

    <ItemGroup Condition="'$(RandomForeseerModVersion)' != ''">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>RandomForeseerModVersion</_Parameter1>
            <_Parameter2>$(RandomForeseerModVersion)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup Condition="'$(RandomForeseerPostHogHost)' != '' and '$(RandomForeseerPostHogProjectApiKey)' != ''">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>RandomForeseerPostHogHost</_Parameter1>
            <_Parameter2>$(RandomForeseerPostHogHost)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>RandomForeseerPostHogProjectApiKey</_Parameter1>
            <_Parameter2>$(RandomForeseerPostHogProjectApiKey)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
        <PackageReference Include="Nothing.STS2RitsuLib.ModAnalyzers" Version="*" PrivateAssets="all" />
        <PackageReference Include="STS2.RitsuLib" Version="0.5.14" GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RandomForeseer.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="True" />
        <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="True" />
        <Reference Include="Steamworks.NET" HintPath="$(Sts2DataDir)\Steamworks.NET.dll" Private="True" />
    </ItemGroup>

    <ItemGroup>
        <!-- 中文：排除 Godot、IDE、构建输出、临时目录和测试目录，避免本地生成文件参与构建。 -->
        <!-- English: Exclude Godot, IDE, build output, temporary directories, and tests from build items. -->
        <Compile Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**;workshop/loader/**;services/**;temp/**;tests/**" />
        <EmbeddedResource Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**;services/**;temp/**;tests/**" />
        <None Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**;workshop/loader/**;services/**;temp/**;tests/**" />
        <Content Remove="temp/**;tests/**" />
        <None Include="workshop/loader/**" />

        <!-- <AdditionalFiles Include="RandomForeseer/localization/**/*.json"/> -->

        <Compile Remove="RandomForeseer/**" />
        <EmbeddedResource Remove="RandomForeseer/**" />
        <None Include="RandomForeseer/**" />
        <None Include="RandomForeseer.json" />
        <None Include="project.godot" />
        <None Include="export_presets.cfg" />
        <None Include=".gitignore" />
        <None Include="local.props.template" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="local.props" Condition="Exists('local.props')" />
    </ItemGroup>

    <Target Name="ValidateSts2GameInstall" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')" Text="Could not find sts2.dll under '$(Sts2DataDir)'. Copy local.props.template to local.props and set Sts2Dir/Sts2DataDir for your local game install." />
    </Target>

    <Target Name="ValidateRandomForeseerModVersion" BeforeTargets="GenerateAssemblyInfo">
        <Error Condition="'$(_HasRandomForeseerModVersion)' != 'True'" Text="Could not read version from '$(RandomForeseerManifestPath)'." />
    </Target>

    <!-- Publish the mod's own files through the SDK's copy pipeline. -->
    <Target Name="ComputeModPublishFiles" AfterTargets="ComputeFilesToPublish"
            DependsOnTargets="SyncManifestDependencies;ExportPCK"
            Condition="'$(IsPublishable)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(STS2_SKIP_PCK_EXPORT)' != '1'">
        <ItemGroup>
            <_ModAssemblyFilesToPublish Include="@(ResolvedFileToPublish)"
                                        Condition="'%(ResolvedFileToPublish.RelativePath)' == '$(TargetFileName)' or '%(ResolvedFileToPublish.RelativePath)' == '$(TargetName).pdb'" />
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" />
            <!-- Always also replaces newer destination files when switching configurations. -->
            <ResolvedFileToPublish Include="@(_ModAssemblyFilesToPublish)" CopyToPublishDirectory="Always" />
            <ResolvedFileToPublish Include="$(RandomForeseerManifestPath)" RelativePath="$(MSBuildProjectName).json" CopyToPublishDirectory="Always" />
            <ResolvedFileToPublish Include="$(_ModPublishPckPath)" RelativePath="$(MSBuildProjectName).pck" CopyToPublishDirectory="Always" />
        </ItemGroup>
    </Target>

    <Target Name="ExportPCK" Condition="'$(DesignTimeBuild)' != 'true' and '$(STS2_SKIP_PCK_EXPORT)' != '1'">
        <Error Condition="'$(GodotExe)' == '' or !Exists('$(GodotExe)')" Text="GodotExe is required for PCK export. Set GodotExe in local.props, or use plain dotnet build to compile without deploying." />
        <PropertyGroup>
            <_ModPublishPckPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(MSBuildProjectName).pck'))</_ModPublishPckPath>
        </PropertyGroup>
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;$(GodotExportPreset)&quot; &quot;$(_ModPublishPckPath)&quot;" EnvironmentVariables="STS2_SKIP_PCK_EXPORT=1" />
        <ItemGroup>
            <FileWrites Include="$(_ModPublishPckPath)" />
        </ItemGroup>
    </Target>

    <Target Name="SyncManifestDependencies" AfterTargets="Build" Condition="'$(SyncManifestDependenciesOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(STS2_SKIP_PCK_EXPORT)' != '1' and '$(PkgSTS2_RitsuLib)' != ''">
        <PropertyGroup>
            <RitsuLibVersion>$([System.IO.Path]::GetFileName('$(PkgSTS2_RitsuLib)'))</RitsuLibVersion>
            <ManifestFile>$(MSBuildProjectDirectory)\$(MSBuildProjectName).json</ManifestFile>
        </PropertyGroup>
        <PropertyGroup>
            <_Json>$([System.IO.File]::ReadAllText('$(ManifestFile)'))</_Json>
            <_VersionSearchPattern>(?s)"id"\s*:\s*"STS2-RitsuLib".*?"min_version"\s*:\s*"([^"]+)"</_VersionSearchPattern>
            <_VersionExtractPattern>(?s).*?"id"\s*:\s*"STS2-RitsuLib".*?"min_version"\s*:\s*"([^"]+)".*</_VersionExtractPattern>
            <_HasRitsuLibVersion>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_Json)', '$(_VersionSearchPattern)'))</_HasRitsuLibVersion>
            <_CurrentRitsuLibVersion Condition="'$(_HasRitsuLibVersion)' == 'True'">$([System.Text.RegularExpressions.Regex]::Replace('$(_Json)', '$(_VersionExtractPattern)', '$1'))</_CurrentRitsuLibVersion>
            <_ManifestNeedsUpdate>false</_ManifestNeedsUpdate>
            <_ManifestNeedsUpdate Condition="'$(_CurrentRitsuLibVersion)' != '' and '$(_CurrentRitsuLibVersion)' != '$(RitsuLibVersion)'">true</_ManifestNeedsUpdate>
        </PropertyGroup>
        <Error Condition="'$(_HasRitsuLibVersion)' != 'True'" Text="Could not find dependencies[STS2-RitsuLib].min_version in '$(ManifestFile)'." />
        <Message Importance="High" Condition="'$(_ManifestNeedsUpdate)' == 'true'" Text="Sync STS2-RitsuLib manifest dependency: $(_CurrentRitsuLibVersion) -&gt; $(RitsuLibVersion)" />
        <Message Importance="Low" Condition="'$(_ManifestNeedsUpdate)' != 'true'" Text="STS2-RitsuLib manifest dependency already matches $(RitsuLibVersion)." />
        <PropertyGroup Condition="'$(_ManifestNeedsUpdate)' == 'true'">
            <_Pattern>(?s)("STS2-RitsuLib".*?"min_version"\s*:\s*")[^"]+(")</_Pattern>
            <_Replacement>${1}$(RitsuLibVersion)${2}</_Replacement>
            <_Updated>$([System.Text.RegularExpressions.Regex]::Replace('$(_Json)', '$(_Pattern)', '$(_Replacement)'))</_Updated>
        </PropertyGroup>
        <ItemGroup Condition="'$(_ManifestNeedsUpdate)' == 'true'">
            <_Lines Include="$([System.Text.RegularExpressions.Regex]::Split('$(_Updated)', '\\r?\\n'))" />
        </ItemGroup>
        <WriteLinesToFile Condition="'$(_ManifestNeedsUpdate)' == 'true'" File="$(ManifestFile)" Lines="@(_Lines)" Overwrite="true" />
    </Target>
</Project>
